# EdgeOne Makers AI Gateway — required for LLM access
AI_GATEWAY_API_KEY=your_api_key_here
AI_GATEWAY_BASE_URL=https://your-gateway-base-url.example.com/v1

# Model (optional, defaults to @makers/minimax-m2.7)
# AI_GATEWAY_MODEL=@makers/minimax-m2.7
# TikHub — optional paid social-data sources (X / Reddit / Weibo / YouTube)
# Register at https://tikhub.io, create a token in the user center
# TIKHUB_TOKEN=your_tikhub_token
# TIKHUB_SOURCES=x,reddit,weibo
# TIKHUB_X_QUERY=AI hardware OR "humanoid robot" OR "AI chip" OR "AI glasses" OR "smart ring" OR "edge AI"
# TIKHUB_REDDIT_SUBS=robotics,MachineLearning,LocalLLaMA,hardware
# TIKHUB_YOUTUBE_QUERY=AI hardware robot
